<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yupi.yuoj.mapper.TestQuestionMapper">

    <resultMap id="BaseResultMap" type="com.yupi.yuoj.model.entity.TestQuestions">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="testId" column="testId" jdbcType="BIGINT"/>
        <result property="questionId" column="questionId" jdbcType="BIGINT"/>
        <result property="title" column="title" jdbcType="VARCHAR"/>
        <result property="score" column="score" jdbcType="INTEGER"/>
        <result property="type" column="type" jdbcType="VARCHAR"/>
        <result property="isDelete" column="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,testId,questionId,
        title,score,type,
        isDelete
    </sql>

    <!-- 统计某个题目被多少个未删除的测验关联（仅统计 test_question 未删除且测验 test 未删除） -->
    <select id="countByQuestionId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM test_question tq
        INNER JOIN test t ON tq.testId = t.id
        WHERE tq.questionId = #{questionId}
          AND tq.isDelete = 0
          AND t.isDelete = 0
    </select>
</mapper>
