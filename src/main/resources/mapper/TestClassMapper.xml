<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yupi.yuoj.mapper.TestClassMapper">

    <resultMap id="BaseResultMap" type="com.yupi.yuoj.model.entity.TestClass">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="testId" column="testId" jdbcType="BIGINT"/>
        <result property="classId" column="classId" jdbcType="BIGINT"/>
        <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
        <result property="isDelete" column="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,testId,classId,
        createTime,updateTime,isDelete
    </sql>

    <!-- 物理删除：按 testId 直接 DELETE，不走逻辑删除 -->
    <delete id="deleteByTestIdPhysical">
        DELETE FROM test_class WHERE testId = #{testId}
    </delete>
</mapper>
